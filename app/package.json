{
  "name": "1ls-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:browser && pnpm run build:site",
    "build:browser": "esbuild ../src/browser/index.ts --bundle --platform=browser --format=esm --outfile=../dist/browser/index.js",
    "build:client": "vite build",
    "build:site": "pnpm run build:client && pnpm run build:ssr && pnpm run prerender",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
    "lint": "oxlint src/ --deny-warnings",
    "lint:agent": "oxlint src/ scripts/ vite.config.ts vite.config.test.ts --format agent --deny-warnings && lint-changed --comments=forbid",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt src/",
    "format:fix": "oxfmt src/ --write",
    "generate:routes": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/generate-routes.ts",
    "typecheck": "pnpm run generate:routes && tsc -b --pretty false",
    "prerender": "node scripts/prerender.ts",
    "preview": "vite preview",
    "deploy": "pnpm run build && gh-pages -d dist",
    "test": "pnpm run build:browser && rm -rf tmp/test-build && esbuild \"src/**/*.test.ts\" \"src/**/*.test.tsx\" --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap=inline --sources-content=true --outdir=tmp/test-build --outbase=. --alias:@=./src && node --import ./src/test/setup.ts --test \"tmp/test-build/src/**/*.test.js\" \"scripts/**/*.test.ts\" \"vite.config.test.ts\""
  },
  "dependencies": {
    "1ls": "file:..",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/db-collections": "^0.0.24",
    "@tanstack/react-db": "^0.1.83",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.3",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.21.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-simple-code-editor": "^0.14.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.31.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.3",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.0.1",
    "@shikijs/transformers": "^4.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/router-generator": "1.167.33",
    "@tanstack/router-devtools": "^1.166.2",
    "@tanstack/router-plugin": "^1.166.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.27.2",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.8.3",
    "postcss": "^8.5.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@^7.3.1"
  }
}
